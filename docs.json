{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cubbo Developers",
  "description": "Developer documentation for the Cubbo Clients API: orders, inventory, replenishments, returns, shipping and webhooks.",
  "colors": {
    "primary": "#327cfb",
    "light": "#60a5fa",
    "dark": "#327cfb"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "guides/authentication"
            ]
          },
          {
            "group": "Working with the API",
            "pages": [
              "guides/errors",
              "guides/pagination",
              "guides/rate-limits"
            ]
          },
          {
            "group": "Events",
            "pages": [
              "guides/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.yaml"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Cubbo",
        "href": "https://cubbo.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get credentials",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/cubbo"
    }
  },
  "background": {
    "color": {
      "light": "#f3f4f6",
      "dark": "#0b1229"
    }
  },
  "styling": {
    "codeblocks": "dark"
  }
}
